#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../lib/poem_exe/compiler'

DEFAULT_DIR = 'example'

dir = Pathname.new(ENV.fetch('POEMEXE_DATA', DEFAULT_DIR))
model = PoemExe::Compiler::ModelBuilder.new(dir:, log: true)

begin
  model.build
rescue PoemExe::Compiler::InputError => e
  warn "Error: #{e}"
  exit 1
end

writer = PoemExe::Compiler::ModelWriter.new(model, log: true)

writer.write(Pathname.new('model.json'), pretty: true)
writer.write(Pathname.new('model.jsonz'))
