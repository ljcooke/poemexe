#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require_relative "../lib/poem_exe"

re = Regexp.new(ARGV.join(" ").strip)

poem_exe = PoemExe::Poet.new

matches = 0
tries = 0

while (matches < 10) && (tries < 12_000)
  poem = poem_exe.generate(single_line: true, month: tries % 12 + 1)
  if re.match? poem
    puts poem
    matches += 1
  end
  tries += 1
end

puts "No matches" unless matches.positive?
