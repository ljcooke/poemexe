#!/usr/bin/env ruby
# frozen_string_literal: true

require 'json'

require_relative '../lib/poem_exe/compiler'

old_model = JSON.parse(File.open('model.old.json').read)

data_dir = Pathname.new(ENV.fetch('POEMEXE_DATA'))
model = PoemExe::Compiler::ModelBuilder.new(dir: data_dir)
new_model = model.build

if old_model.keys == new_model.keys.map(&:to_s)
  new_model.each do |key, builder|
    old_data = old_model.fetch(key.to_s)
    new_data = builder.build
    if key == :verses
      old_json = old_data.map(&:to_json).uniq.sort.join('|')
      new_json = new_data.map(&:to_json).uniq.sort.join('|')
    else
      old_json = old_data.to_json
      new_json = new_data.to_json
    end
    puts "#{key} : #{old_json == new_json ? :match : :changed}"
    if old_json != new_json
      puts "  #{old_json[0...80]}"
      puts "  #{new_json[0...80]}"
    end
  end
else
  puts "Old keys: #{old_model.keys.inspect}"
  puts "New keys: #{new_model.keys.inspect}"
end
