#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require_relative "../lib/poem_exe"

class Tester
  def initialize(options)
    @poem_exe = PoemExe::Poet.new(options)
  end

  def run
    (1..12).each { test_month(_1) }
  end

  def test_month(month)
    prefix = format("%02d", month)
    2.times do |i|
      prefix = i.zero? ? "#{month.to_s.rjust(2)}." : ""
      poem = gen_poem(month:)
      print_poem(poem, prefix:)
    end
  end

  def print_poem(poem, prefix:)
    text = poem ? poem.fetch(:text) : "-"
    extras = "[#{poem.fetch(:score)}]" if poem
    puts "#{prefix.ljust(3)} #{text} #{extras}".rstrip
  end

  def gen_poem(month:)
    poem = nil
    5.times do
      poem = @poem_exe.generate(single_line: true, month:, details: true)
      break if poem[:score] == :strong
    end
    poem
  end
end

options = {}
options[:oulipo] = true if ARGV.include? "--oulipo"

Tester.new(options).run
